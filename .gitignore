# OS
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native build artifacts (the Android and iOS source projects are committed).
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/.xcode.env.local
ios/ChatHouse/GoogleService-Info.plist
# Android build artifacts stay ignored via android/.gitignore and the generic
# `build/` rule below. Only source + Gradle wrapper + debug.keystore commit.
*.jks
*.keystore
# debug.keystore is intentionally committed (shared debug signing); the rule
# above would otherwise catch it.
!android/app/debug.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Env
.env
.env.local
.env.*.local
# Real per-environment front-end files (contain public hosts + Maps key).
# The committed templates are .env.example / .env.production.example.
.env.production
.env.staging

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs
*.log

# Tests
coverage/

# Build
build/

# Build artifacts: prebuilt APKs are large binaries that bloat the repo and
# stall HTTP pushes — keep them on disk but out of git. Produce via gradle.
*.apk

# Uploaded media (avatars) — created at runtime by the backend upload module;
# the files are environment-specific and must not be versioned. The directory
# is mkdir'd on first write (backend/src/modules/upload/upload.service.ts).
backend/uploads/
# Private development/test fallback for the object-storage adapter. This path
# is never exposed by Express and production is required to use S3-compatible
# storage.
backend/private-media/

# Firebase (carries project API key) — provided locally / via CI secret, not
# committed. Match any location so a stray copy can't slip in.
google-services.json
