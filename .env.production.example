# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION front-end env. Copy to `.env.production` (gitignored) and fill in
# the REAL public hosts, then build a release bundle so these values are inlined:
#
#   PowerShell: .\scripts\build-release-aab.ps1 -VersionCode 42 -VersionName 1.4.0
#   macOS/Linux with PowerShell 7:
#     pwsh ./scripts/build-release-aab.ps1 -VersionCode 42 -VersionName 1.4.0
#
# Do not invoke bundleRelease directly for a store artifact. The versioned
# script validates production endpoints, Firebase, Maps and upload signing.
#
# react-native-dotenv (babel.config.js) inlines these into the JS bundle at build
# time. src/config/env.ts fail-fasts at boot when ENV=production still points at a
# local or cleartext endpoint — so every URL below MUST be public https:// / wss://.
# ─────────────────────────────────────────────────────────────────────────────

ENV=production
LEGAL_DOCUMENT_VERSION=2026-07-29

# Public API + WebSocket origins (behind your TLS reverse proxy). HTTPS/WSS only.
API_BASE_URL=https://api.chathouse.app/api
WS_BASE_URL=wss://api.chathouse.app
REALTIME_ENABLED=true

# LiveKit public WSS endpoint — LiveKit Cloud (wss://<project>.livekit.cloud) or
# your self-hosted wss://livekit.chathouse.app. WSS only in production.
LIVEKIT_URL=wss://your-project.livekit.cloud

# Google Maps Android key. Restrict it by package (com.chathouse.app) + the Play
# App-Signing SHA-1. Injected into the manifest at build time.
GOOGLE_MAPS_API_KEY=__CHANGE_ME__

# Optional: Sentry DSN for crash/error reporting (leave empty to disable).
SENTRY_DSN=
