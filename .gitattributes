# Scripts that run inside Linux containers MUST keep LF line endings, even when
# checked out on Windows with core.autocrlf=true — a CRLF shebang (`#!/bin/sh\r`)
# fails to execute. (The Docker builder also strips CRLF defensively at runtime.)
*.sh text eol=lf
docker/android/entrypoint.sh text eol=lf
gradlew text eol=lf
*.patch text eol=lf
