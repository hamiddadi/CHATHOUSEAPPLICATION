# ─── Runtime ────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Docker Compose publishes API/WebRTC ports on loopback by default. Set this
# explicitly to 0.0.0.0 only when a trusted LAN device must reach the dev host.
DEV_BIND_ADDRESS=127.0.0.1

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://chathouse:chathouse@localhost:5432/chathouse?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Production Compose memory ceiling. It deliberately uses noeviction because
# Redis contains BullMQ jobs and revoked-token keys that must not disappear.
REDIS_MAXMEMORY=512mb

# ─── Auth (JWT) ─────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=chathouse-api
JWT_AUDIENCE=chathouse-app
# Temporary rolling-deploy bridge for JWTs minted without BOTH iss and aud.
# Disabled by default. Set only during the documented two-phase rollout, to an
# absolute ISO timestamp no later than seven days after the strict-emission deploy.
# JWT_LEGACY_NO_ISS_AUD_ACCEPT_UNTIL=2026-08-20T12:00:00Z

# ─── CORS (comma-separated) ─────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:4000,http://127.0.0.1:4000,https://chathouse.app

# Private media. `local` is development/test only and is served through signed
# /media URLs (never express.static). Production must use `s3`.
PUBLIC_URL=http://localhost:4000
# Public legal pages use development fallbacks unless these are configured.
# Production requires reviewed, non-placeholder values for every field.
# LEGAL_ENTITY_NAME=
# LEGAL_REGISTERED_ADDRESS=
# LEGAL_REGISTRATION_NUMBER=
# LEGAL_JURISDICTION=
# LEGAL_DISPUTE_PROCESS=
# LEGAL_LIABILITY_TERMS=
# LEGAL_SUPERVISORY_AUTHORITY=
# LEGAL_TRANSFER_SAFEGUARDS=
# LEGAL_DPO_CONTACT=
# LEGAL_EU_REPRESENTATIVE=
# LEGAL_DOCUMENT_VERSION=
# LEGAL_DOCUMENT_EFFECTIVE_DATE=
# LEGAL_SERVICE_PROVIDERS=
# LEGAL_PROCESSING_LOCATIONS=
# LEGAL_LOG_BACKUP_RETENTION=
# LEGAL_SUPPORT_MODERATION_RETENTION=
# LEGAL_MODERATION_APPEAL_ROUTE=
# LEGAL_ADULT_CONTENT_POLICY=
# LEGAL_CHILD_SAFETY_REPORTING_PROCESS=
# LEGAL_CONTACT_PHONE=
# PRIVACY_CONTACT_EMAIL=
# SUPPORT_CONTACT_EMAIL=
# SAFETY_CONTACT_EMAIL=
# CHILD_SAFETY_CONTACT_NAME=
# CHILD_SAFETY_CONTACT_EMAIL=
# APPLE_TEAM_ID=
# ANDROID_APP_SIGNING_SHA256=
MEDIA_STORAGE_DRIVER=local
MEDIA_URL_SIGNING_SECRET=change-me-media-signing-secret-min-32-chars
# Expiring private-media links embedded in a GDPR JSON export (default 1 hour).
MEDIA_EXPORT_URL_TTL_SECONDS=3600
VOICE_MEDIA_ABANDONED_TTL_HOURS=48
VOICE_MEDIA_DELETE_CLAIM_TTL_MINUTES=60
VOICE_MEDIA_CLEANUP_BATCH_SIZE=100
VOICE_MEDIA_CLEANUP_CONCURRENCY=5
VOICE_MEDIA_CLEANUP_CRON=17 * * * *
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=https://s3.example.com
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=false

# Room recording is release-disabled until participant consent exists.
ROOM_RECORDING_ENABLED=false
EGRESS_ENABLED=false

# ─── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
LEGACY_EMAIL_AUTH_ENABLED=true

# Exact phone-number contact discovery is privacy-sensitive and disabled by
# default. Enable only after documenting user consent/discoverability policy.
CONTACT_MATCH_ENABLED=false

# Short-lived private media capabilities used by the app. Persisted legacy
# stable URLs remain readable during the rolling migration window only.
MEDIA_APP_URL_TTL_SECONDS=900
# Optional bounded rolling-client grace period (ISO timestamp). Leave unset to
# reject the old non-expiring /media/:id/:signature download route.
# MEDIA_LEGACY_STABLE_READ_UNTIL=2026-09-01T00:00:00Z

# GDPR retention (validated at boot)
ACCOUNT_DELETION_GRACE_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
GDPR_PURGE_CRON=0 3 * * *

# ─── OTP / SMS (Module 1) ───────────────────────────────
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5
# Dev/QA only (ignored when NODE_ENV=production): comma-separated phone numbers
# that skip the real SMS/OTP and log in with OTP_TEST_CODE. Matched by
# digit-suffix, so "550728585" also matches "+213550728585".
# OTP_TEST_NUMBERS=550728585
# OTP_TEST_CODE=000000
# Fill these in production to use Twilio SMS instead of the dev logger.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ─── Email / password reset ──────────────────────────────
# Development/test use a non-delivering stub that never logs the message body
# or reset token. Both values are mandatory in production; MAIL_FROM must be a
# sender address on a domain verified in Resend.
# RESEND_API_KEY=re_...
# MAIL_FROM=no-reply@example.com

# ─── Push (Module 6) — Firebase Cloud Messaging ─────────
# Development/test may leave this false to use the non-delivering local stub.
# Production requires true and refuses to boot otherwise.
PUSH_DISPATCH_ENABLED=false
# firebase-admin service-account credentials (Firebase console → Project
# settings → Service accounts → Generate new private key). Paste the complete
# JSON as one line, or explicitly enable ADC. Configure exactly one mode.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"…"}
# FIREBASE_USE_ADC=true
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# ─── LiveKit (audio engine token signing) ────────────────
# LIVEKIT_URL is the WebSocket endpoint of the LiveKit server.
# API_KEY and API_SECRET are used to sign per-room JWT tokens.
# The secret must NEVER be exposed to client builds.
# Run a local server: docker run -p 7880:7880 livekit/livekit-server --dev
LIVEKIT_URL=ws://localhost:7880
# Optional server-to-server URL. Leave blank for direct local runs/Cloud;
# docker-compose injects http://livekit:7880 inside the API container.
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Token TTL in seconds. Runtime is capped at 300s; clients renew before expiry.
LIVEKIT_TOKEN_TTL_SECONDS=300
