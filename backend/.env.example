# ─── Runtime ────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://chathouse:chathouse@localhost:5432/chathouse?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (JWT) ─────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── CORS (comma-separated) ─────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://chathouse.app

# Private media. `local` is development/test only and is served through signed
# /media URLs (never express.static). Production must use `s3`.
PUBLIC_URL=http://localhost:4000
# Public legal pages use development fallbacks unless these are configured.
# Production requires reviewed, non-placeholder values for every field.
# LEGAL_ENTITY_NAME=
# LEGAL_REGISTERED_ADDRESS=
# LEGAL_JURISDICTION=
# LEGAL_SUPERVISORY_AUTHORITY=
# LEGAL_TRANSFER_SAFEGUARDS=
# PRIVACY_CONTACT_EMAIL=
# SUPPORT_CONTACT_EMAIL=
# APPLE_TEAM_ID=
# ANDROID_APP_SIGNING_SHA256=
MEDIA_STORAGE_DRIVER=local
MEDIA_URL_SIGNING_SECRET=change-me-media-signing-secret-min-32-chars
# Expiring private-media links embedded in a GDPR JSON export (default 1 hour).
MEDIA_EXPORT_URL_TTL_SECONDS=3600
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=https://s3.example.com
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=false

# Room recording is release-disabled until participant consent exists.
ROOM_RECORDING_ENABLED=false
EGRESS_ENABLED=false

# ─── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# GDPR retention (validated at boot)
ACCOUNT_DELETION_GRACE_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
GDPR_PURGE_CRON=0 3 * * *

# ─── OTP / SMS (Module 1) ───────────────────────────────
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5
# Dev/QA only (ignored when NODE_ENV=production): comma-separated phone numbers
# that skip the real SMS/OTP and log in with OTP_TEST_CODE. Matched by
# digit-suffix, so "550728585" also matches "+213550728585".
# OTP_TEST_NUMBERS=550728585
# OTP_TEST_CODE=000000
# Fill these in production to use Twilio SMS instead of the dev logger.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ─── Email / password reset ──────────────────────────────
# Development/test use a non-delivering stub that never logs the message body
# or reset token. Both values are mandatory in production; MAIL_FROM must be a
# sender address on a domain verified in Resend.
# RESEND_API_KEY=re_...
# MAIL_FROM=no-reply@example.com

# ─── Push (Module 6) — Firebase Cloud Messaging ─────────
# Development/test may leave this false to use the non-delivering local stub.
# Production requires true and refuses to boot otherwise.
PUSH_DISPATCH_ENABLED=false
# firebase-admin service-account credentials (Firebase console → Project
# settings → Service accounts → Generate new private key). Paste the complete
# JSON as one line, or explicitly enable ADC. Configure exactly one mode.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"…"}
# FIREBASE_USE_ADC=true
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# ─── LiveKit (audio engine token signing) ────────────────
# LIVEKIT_URL is the WebSocket endpoint of the LiveKit server.
# API_KEY and API_SECRET are used to sign per-room JWT tokens.
# The secret must NEVER be exposed to client builds.
# Run a local server: docker run -p 7880:7880 livekit/livekit-server --dev
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Token TTL in seconds. Clients renew ~30s before expiry; 1h is sane.
LIVEKIT_TOKEN_TTL_SECONDS=3600
