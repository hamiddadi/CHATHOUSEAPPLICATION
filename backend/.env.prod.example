# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION secrets for docker-compose.prod.yml.
# Copy to `.env` on the production host (NOT committed), `chmod 600`, fill in,
# and the compose file will fail loudly at boot if any required value is missing.
# Generate strong values, e.g.:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=chathouse
POSTGRES_PASSWORD=__CHANGE_ME__strong-random__
POSTGRES_DB=chathouse

# Redis (AUTH is enforced in prod)
REDIS_PASSWORD=__CHANGE_ME__strong-random__

# GDPR retention
ACCOUNT_DELETION_GRACE_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
GDPR_PURGE_CRON=0 3 * * *

# JWT signing (min 32 chars each — backend env.ts rejects shorter)
JWT_ACCESS_SECRET=__CHANGE_ME__at-least-32-characters-long__
JWT_REFRESH_SECRET=__CHANGE_ME__at-least-32-characters-long__

# CORS — the public origins of the mobile app / web client
CORS_ORIGINS=https://app.chathouse.app
PUBLIC_URL=https://api.chathouse.app

# Private S3-compatible media storage (bucket public access must stay blocked).
MEDIA_STORAGE_DRIVER=s3
MEDIA_URL_SIGNING_SECRET=__CHANGE_ME__at-least-32-characters-long__
# GDPR export links expire after one hour (300..604800 seconds).
MEDIA_EXPORT_URL_TTL_SECONDS=3600
MEDIA_S3_BUCKET=chathouse-private-media
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=__CHANGE_ME__
MEDIA_S3_SECRET_KEY=__CHANGE_ME__
MEDIA_S3_FORCE_PATH_STYLE=false

# Recording stays disabled until explicit participant consent is delivered.
ROOM_RECORDING_ENABLED=false
EGRESS_ENABLED=false

# ─── LiveKit (REQUIRED — live audio returns 503 without it) ───
# LiveKit Cloud (recommended): create a project, copy its values.
# Self-host: LIVEKIT_URL = wss://livekit.chathouse.app (the `livekit` service
# behind your TLS proxy), key/secret must match the LIVEKIT_KEYS env there.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=__CHANGE_ME__
LIVEKIT_API_SECRET=__CHANGE_ME__
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ─── SMS / OTP (Twilio) — REQUIRED (phone + OTP is the only login path) ───
# Sign up at https://www.twilio.com, buy an SMS-capable number, then copy the
# Account SID + Auth Token from the console. FROM_NUMBER must be E.164.
TWILIO_ACCOUNT_SID=__CHANGE_ME__
TWILIO_AUTH_TOKEN=__CHANGE_ME__
TWILIO_FROM_NUMBER=+15551234567

# ─── Push notifications (Firebase Cloud Messaging) — OPTIONAL ───
# Firebase console → Project settings → Service accounts → Generate new private
# key, then paste the JSON as a SINGLE LINE below. Set PUSH_DISPATCH_ENABLED=true
# to actually send; leave false/unset to boot without push.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
PUSH_DISPATCH_ENABLED=false

# Stripe remains available; webhook verification is mandatory.
STRIPE_SECRET_KEY=sk_live___CHANGE_ME__
STRIPE_WEBHOOK_SECRET=whsec___CHANGE_ME__
STRIPE_RETURN_URL=https://app.chathouse.app/payments/return
STRIPE_REFRESH_URL=https://app.chathouse.app/payments/refresh

# TLS reverse proxy (Caddy) — email for Let's Encrypt expiry notices
ACME_EMAIL=admin@chathouse.app

# ─── Observability (optional) ───
SENTRY_DSN=
# Bearer token that gates GET /metrics in prod (leave empty to keep it open
# only on the loopback interface behind your proxy).
METRICS_TOKEN=

# Set by the CD pipeline at deploy time — no need to fill manually.
# CHATHOUSE_API_IMAGE=ghcr.io/<owner>/chathouse/api:1.0.0
