# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION secrets for docker-compose.prod.yml.
# Copy to `.env` on the production host (NOT committed), `chmod 600`, fill in,
# and the compose file will fail loudly at boot if any required value is missing.
# Generate strong values, e.g.:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=chathouse
POSTGRES_PASSWORD=__CHANGE_ME__strong-random__
POSTGRES_DB=chathouse

# Redis (AUTH is enforced in prod)
REDIS_PASSWORD=__CHANGE_ME__strong-random__

# GDPR retention
ACCOUNT_DELETION_GRACE_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
GDPR_PURGE_CRON=0 3 * * *

# JWT signing (min 32 chars each — backend env.ts rejects shorter)
JWT_ACCESS_SECRET=__CHANGE_ME__at-least-32-characters-long__
JWT_REFRESH_SECRET=__CHANGE_ME__at-least-32-characters-long__

# CORS — the public origins of the mobile app / web client
CORS_ORIGINS=https://app.chathouse.app
PUBLIC_URL=https://api.chathouse.app

# Private S3-compatible media storage (bucket public access must stay blocked).
MEDIA_STORAGE_DRIVER=s3
MEDIA_URL_SIGNING_SECRET=__CHANGE_ME__at-least-32-characters-long__
# GDPR export links expire after one hour (300..604800 seconds).
MEDIA_EXPORT_URL_TTL_SECONDS=3600
MEDIA_S3_BUCKET=chathouse-private-media
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=__CHANGE_ME__
MEDIA_S3_SECRET_KEY=__CHANGE_ME__
MEDIA_S3_FORCE_PATH_STYLE=false

# Recording stays disabled until explicit participant consent is delivered.
ROOM_RECORDING_ENABLED=false
EGRESS_ENABLED=false

# ─── LiveKit (REQUIRED — live audio returns 503 without it) ───
# LiveKit Cloud (recommended): create a project, copy its values.
# Self-host: LIVEKIT_URL = wss://livekit.chathouse.app (the `livekit` service
# behind your TLS proxy), key/secret must match the LIVEKIT_KEYS env there.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=__CHANGE_ME__
LIVEKIT_API_SECRET=__CHANGE_ME__
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ─── SMS / OTP (Twilio) — REQUIRED (phone + OTP is the only login path) ───
# Sign up at https://www.twilio.com, buy an SMS-capable number, then copy the
# Account SID + Auth Token from the console. FROM_NUMBER must be E.164.
TWILIO_ACCOUNT_SID=__CHANGE_ME__
TWILIO_AUTH_TOKEN=__CHANGE_ME__
TWILIO_FROM_NUMBER=+15551234567

# ─── Email / password reset (Resend) — REQUIRED ───
# Create an API key after verifying the MAIL_FROM domain in Resend. Password
# reset requests fail closed when either value is absent or invalid.
RESEND_API_KEY=re___CHANGE_ME__
MAIL_FROM=no-reply@chathouse.app

# ─── Push notifications (Firebase Cloud Messaging) — REQUIRED ───
# Production refuses to boot unless dispatch is enabled and exactly one
# credential mode is selected.
PUSH_DISPATCH_ENABLED=true
#
# Mode A — paste the COMPLETE Firebase service-account JSON on one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
#
# Mode B — use runtime-managed Application Default Credentials (workload
# identity, instance metadata, or a GOOGLE_APPLICATION_CREDENTIALS file that
# your deployment separately mounts inside the container). Set true only when
# the runtime identity can access Firebase/FCM.
FIREBASE_USE_ADC=false
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Stripe remains available; webhook verification is mandatory.
STRIPE_SECRET_KEY=sk_live___CHANGE_ME__
STRIPE_WEBHOOK_SECRET=whsec___CHANGE_ME__
STRIPE_RETURN_URL=https://app.chathouse.app/payments/return
STRIPE_REFRESH_URL=https://app.chathouse.app/payments/refresh

# TLS reverse proxy (Caddy) — email for Let's Encrypt expiry notices
ACME_EMAIL=admin@chathouse.app

# ─── Observability ───
SENTRY_DSN=
# Absolute host path to a 32-byte-or-longer random token file. Both the API and
# Prometheus mount this file as a Compose secret; never put its contents here.
METRICS_TOKEN_SECRET_FILE=/opt/chathouse/secrets/metrics_token
# Required only by docker/monitoring/docker-compose.monitoring.yml. Leave empty
# in this template so Compose refuses to start until a strong value is set.
GF_SECURITY_ADMIN_PASSWORD=

# Alertmanager renders non-secret routing values, while credentials are mounted
# from host files and never copied into this env file.
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@chathouse.app
SMTP_USERNAME=alerts@chathouse.app
ALERT_EMAIL_TO=oncall@chathouse.app
ALERTMANAGER_SLACK_WEBHOOK_SECRET_FILE=/opt/chathouse/secrets/alertmanager_slack_webhook
ALERTMANAGER_SMTP_PASSWORD_SECRET_FILE=/opt/chathouse/secrets/alertmanager_smtp_password

# Backup sidecar (optional S3 values may remain empty only if local backups are
# explicitly accepted; production should use encrypted offsite storage).
POSTGRES_ADMIN_DB=postgres
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=chathouse
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Required for first host bootstrap and operator-driven Compose calls.
# CD overrides this value with the immutable image for each deployment.
CHATHOUSE_API_IMAGE=ghcr.io/__OWNER__/__REPOSITORY__/api@sha256:__64_LOWERCASE_HEX__
