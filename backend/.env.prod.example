# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION secrets for docker-compose.prod.yml.
# Copy to `.env` on the production host (NOT committed), `chmod 600`, fill in,
# and the compose file will fail loudly at boot if any required value is missing.
# Generate strong values, e.g.:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Postgres identifiers and Postgres / Redis passwords are interpolated directly
# into internal DSNs by docker-compose.prod.yml. Use only RFC 3986 unreserved
# characters (A-Z, a-z, 0-9, dot, underscore, tilde, hyphen). For passwords,
# `openssl rand -hex 32` satisfies this contract; the Go-Live preflight rejects
# other forms.

# Postgres. POSTGRES_USER owns migrations/bootstrap only; the API receives the
# distinct non-superuser POSTGRES_APP_USER credentials.
POSTGRES_USER=chathouse_migrator
POSTGRES_PASSWORD=__CHANGE_ME__strong-random__
POSTGRES_DB=chathouse
POSTGRES_APP_USER=chathouse_app
POSTGRES_APP_PASSWORD=__CHANGE_ME__different-strong-random__
# Bounded Prisma pools and container resources. Tune only after observing DB
# saturation and RSS/CPU metrics; these defaults cap one API + security worker.
DATABASE_CONNECTION_LIMIT=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=20000
LIVEKIT_WORKER_DATABASE_CONNECTION_LIMIT=5
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=2.0
LIVEKIT_WORKER_MEMORY_LIMIT=512m
LIVEKIT_WORKER_CPU_LIMIT=1.0

# Redis (AUTH is enforced in prod)
REDIS_PASSWORD=__CHANGE_ME__strong-random__
# Size for the Redis maxmemory ceiling. `noeviction` is fixed by Compose so
# BullMQ jobs and revoked-token keys are never silently discarded.
REDIS_MAXMEMORY=512mb

# GDPR retention
ACCOUNT_DELETION_GRACE_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
GDPR_PURGE_CRON=0 3 * * *

# JWT signing (min 32 chars each — backend env.ts rejects shorter)
JWT_ACCESS_SECRET=__CHANGE_ME__at-least-32-characters-long__
JWT_REFRESH_SECRET=__CHANGE_ME__at-least-32-characters-long__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=chathouse-api
JWT_AUDIENCE=chathouse-app
# STRICT DEFAULT: leave empty for normal operation. For the first rolling deploy
# only, set an absolute UTC timestamp <= 7 days ahead so already-issued tokens
# that contain neither iss nor aud can drain. Remove it in phase 2.
JWT_LEGACY_NO_ISS_AUD_ACCEPT_UNTIL=

# CORS — comma-separated canonical HTTPS origins without a path, query or
# fragment. Include the public web origin plus the canonical API origin used as
# Origin by React Native's Socket.IO WebSocket handshake.
CORS_ORIGINS=https://app.chathouse.com,https://api.chathouse.app
PUBLIC_URL=https://api.chathouse.app

# Contact matching remains opt-in at both deployment and user level. Enabling
# this flag only exposes opted-in users through the authenticated extension.
CONTACT_MATCH_ENABLED=false

# Reviewed legal identity used by the public /privacy, /terms,
# /community-guidelines, /child-safety, /account-deletion and /support pages.
# Production refuses to boot while any value is missing or still contains a
# template marker.
LEGAL_ENTITY_NAME=__CHANGE_ME__
LEGAL_REGISTERED_ADDRESS=__CHANGE_ME__
LEGAL_REGISTRATION_NUMBER=__CHANGE_ME__
LEGAL_JURISDICTION=__CHANGE_ME__
LEGAL_DISPUTE_PROCESS=__CHANGE_ME__
LEGAL_LIABILITY_TERMS=__CHANGE_ME__
LEGAL_SUPERVISORY_AUTHORITY=__CHANGE_ME__
LEGAL_TRANSFER_SAFEGUARDS=__CHANGE_ME__
LEGAL_DPO_CONTACT=__CHANGE_ME_OR_NOT_APPOINTED__
LEGAL_EU_REPRESENTATIVE=__CHANGE_ME_OR_NOT_APPLICABLE__
LEGAL_DOCUMENT_VERSION=__CHANGE_ME__
LEGAL_DOCUMENT_EFFECTIVE_DATE=__CHANGE_ME__
LEGAL_SERVICE_PROVIDERS=__CHANGE_ME__
LEGAL_PROCESSING_LOCATIONS=__CHANGE_ME__
LEGAL_LOG_BACKUP_RETENTION=__CHANGE_ME__
LEGAL_SUPPORT_MODERATION_RETENTION=__CHANGE_ME__
LEGAL_MODERATION_APPEAL_ROUTE=__CHANGE_ME__
LEGAL_ADULT_CONTENT_POLICY=__CHANGE_ME__
LEGAL_CHILD_SAFETY_REPORTING_PROCESS=__CHANGE_ME__
LEGAL_CONTACT_PHONE=__CHANGE_ME__
PRIVACY_CONTACT_EMAIL=privacy@example.com
SUPPORT_CONTACT_EMAIL=support@example.com
SAFETY_CONTACT_EMAIL=safety@example.com
CHILD_SAFETY_CONTACT_NAME=__CHANGE_ME__
CHILD_SAFETY_CONTACT_EMAIL=child-safety@example.com
# Public identifiers (not private keys). Use the Apple Developer Team ID and
# the Google Play App Signing SHA-256 certificate fingerprint.
APPLE_TEAM_ID=__CHANGE_ME__
ANDROID_APP_SIGNING_SHA256=__CHANGE_ME__

# Private S3-compatible media storage (bucket public access must stay blocked).
MEDIA_STORAGE_DRIVER=s3
MEDIA_URL_SIGNING_SECRET=__CHANGE_ME__at-least-32-characters-long__
# Short-lived app capabilities (60..3600 seconds).
MEDIA_APP_URL_TTL_SECONDS=900
# GDPR export links expire after one hour (300..604800 seconds).
MEDIA_EXPORT_URL_TTL_SECONDS=3600
# First state-v2 deployment only: replace the expired sentinel with an
# absolute UTC timestamp no more than 30 days ahead. Keep the value after the
# window closes so cached legacy capabilities deterministically return 404.
MEDIA_LEGACY_STABLE_READ_UNTIL=1970-01-01T00:00:00Z
VOICE_MEDIA_ABANDONED_TTL_HOURS=48
VOICE_MEDIA_DELETE_CLAIM_TTL_MINUTES=60
VOICE_MEDIA_CLEANUP_BATCH_SIZE=100
VOICE_MEDIA_CLEANUP_CONCURRENCY=5
VOICE_MEDIA_CLEANUP_CRON=17 * * * *
MEDIA_S3_BUCKET=chathouse-private-media
# Real provider region (`auto` is valid for Cloudflare R2); placeholders fail
# the Go-Live preflight.
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=__CHANGE_ME__
MEDIA_S3_SECRET_KEY=__CHANGE_ME__
MEDIA_S3_FORCE_PATH_STYLE=false

# Recording stays disabled until explicit participant consent is delivered.
ROOM_RECORDING_ENABLED=false
EGRESS_ENABLED=false

# ─── LiveKit (REQUIRED — live audio returns 503 without it) ───
# LiveKit Cloud (recommended): create a project, copy its values.
# Self-host: LIVEKIT_URL = wss://livekit.chathouse.app (client-facing TLS URL)
# and LIVEKIT_INTERNAL_URL = http://livekit:7880 (API-container admin calls).
# For LiveKit Cloud, leave LIVEKIT_INTERNAL_URL empty to reuse the public host.
# Key/secret must match the LIVEKIT_KEYS env for a self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=__CHANGE_ME__
LIVEKIT_API_SECRET=__CHANGE_ME__
# Five-minute maximum limits stale room access after a kick or room closure.
LIVEKIT_TOKEN_TTL_SECONDS=300

# ─── SMS / OTP (Twilio) — REQUIRED (phone + OTP is the only login path) ───
# Sign up at https://www.twilio.com, buy an SMS-capable number, then copy the
# Account SID + Auth Token from the console. FROM_NUMBER must be E.164.
TWILIO_ACCOUNT_SID=__CHANGE_ME__
TWILIO_AUTH_TOKEN=__CHANGE_ME__
TWILIO_FROM_NUMBER=+15551234567

# ─── Email / password reset (Resend) — REQUIRED ───
# Create an API key after verifying the MAIL_FROM domain in Resend. Password
# reset requests fail closed when either value is absent or invalid.
RESEND_API_KEY=re___CHANGE_ME__
MAIL_FROM=no-reply@chathouse.app

# ─── Push notifications (Firebase Cloud Messaging) — REQUIRED ───
# Production refuses to boot unless dispatch is enabled and exactly one
# credential mode is selected.
PUSH_DISPATCH_ENABLED=true
#
# Mode A — paste the COMPLETE Firebase service-account JSON on one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
#
# Mode B — use runtime-managed Application Default Credentials (workload
# identity, instance metadata, or a GOOGLE_APPLICATION_CREDENTIALS file that
# your deployment separately mounts inside the container). Set true only when
# the runtime identity can access Firebase/FCM.
FIREBASE_USE_ADC=false
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Stripe is optional. Leave ALL four values empty to disable it. If any value
# is set, production boot requires the complete live-mode/HTTPS set and
# EXTENSIONS_ENABLED=true (the default).
EXTENSIONS_ENABLED=true
# Live values, when enabled, must start with sk_live_ and whsec_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=
STRIPE_REFRESH_URL=

# TLS reverse proxy (Caddy) — email for Let's Encrypt expiry notices
ACME_EMAIL=admin@chathouse.app

# ─── Observability ───
SENTRY_DSN=
# Absolute, existing host path to a 32-byte-or-longer random token file. Both
# the API and Prometheus mount this file as a Compose secret; never put its
# contents here.
METRICS_TOKEN_SECRET_FILE=/opt/chathouse/secrets/metrics_token
# Required only by docker/monitoring/docker-compose.monitoring.yml. Leave empty
# in this template so Compose refuses to start until a strong value is set.
GF_SECURITY_ADMIN_PASSWORD=

# Alertmanager renders non-secret routing values, while credentials are mounted
# from host files and never copied into this env file.
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@chathouse.app
SMTP_USERNAME=alerts@chathouse.app
ALERT_EMAIL_TO=oncall@chathouse.app
ALERTMANAGER_SLACK_WEBHOOK_SECRET_FILE=/opt/chathouse/secrets/alertmanager_slack_webhook
ALERTMANAGER_SMTP_PASSWORD_SECRET_FILE=/opt/chathouse/secrets/alertmanager_smtp_password

# Backup sidecar (optional S3 values may remain empty only if local backups are
# explicitly accepted; production should use encrypted offsite storage).
POSTGRES_ADMIN_DB=postgres
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=chathouse
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Required for first host bootstrap and operator-driven Compose calls.
# CD overrides this value with the immutable image for each deployment.
CHATHOUSE_API_IMAGE=ghcr.io/__OWNER__/__REPOSITORY__/api@sha256:__64_LOWERCASE_HEX__
